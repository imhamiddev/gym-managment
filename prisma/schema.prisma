generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// role: "COACH" | "ATHLETE"
model User {
  id           String      @id @default(cuid())
  phone        String      @unique
  firstName    String
  lastName     String
  passwordHash String
  role         String
  createdAt    DateTime    @default(now())
  gym          Gym?
  membership   Membership?
  pushSubscriptions PushSubscription[]
  coachOf      GymCoach? // assistant coach in someone else's gym (the owner is Gym.coachId)
}

// Each coach owns at most one gym (coachId is unique)
model Gym {
  id          String       @id @default(cuid())
  name        String
  code        String       @unique
  coachId     String       @unique
  coach       User         @relation(fields: [coachId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  memberships Membership[]
  plans       Plan[]
  coaches     GymCoach[] // assistant coaches (the owner is `coach`)

  // Weekdays the gym is open, JS numbering: 0 = Sunday ... 6 = Saturday. Default: every day.
  workDays    Int[]        @default([0, 1, 2, 3, 4, 5, 6])
  openTime    String       @default("06:00") // HH:MM, Tehran time
  closeTime   String       @default("22:00") // HH:MM, Tehran time
  cardNumber  String? // 16 digits, shown to athletes for tuition transfers
}

// status: "PENDING" | "APPROVED". Each athlete has at most one membership (athleteId is unique)
model Membership {
  id          String       @id @default(cuid())
  gymId       String
  athleteId   String       @unique
  status      String       @default("PENDING")
  createdAt   DateTime     @default(now())
  approvedAt  DateTime?
  gym         Gym          @relation(fields: [gymId], references: [id], onDelete: Cascade)
  athlete     User         @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  // Coach-managed profile
  heightCm    Int?
  weightKg    Float?
  goal        String? // shown to the athlete
  program     String? // training program, shown to the athlete
  notes       String? // private coach notes
  birthYmd    String? // Gregorian YYYY-MM-DD
  payments    Payment[]
  attendances Attendance[]
  reminders   ReminderLog[]

  @@index([gymId])
}

model Payment {
  id           String     @id @default(cuid())
  membershipId String
  amount       Int // toman
  paidAt       DateTime // stored at 12:00 UTC of the paid day
  durationDays Int // 30 | 60 | 90
  createdAt    DateTime   @default(now())
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([membershipId])
}

model Attendance {
  id           String     @id @default(cuid())
  membershipId String
  date         String // Gregorian YYYY-MM-DD
  present      Boolean
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, date])
}

// One row per browser/device that allowed notifications
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Makes each tuition reminder (2 days / 1 day / due day) go out only once per payment period
model ReminderLog {
  id           String     @id @default(cuid())
  membershipId String
  endYmd       String // the day the tuition period ends
  daysLeft     Int // 2 | 1 | 0
  sentAt       DateTime   @default(now())
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, endYmd, daysLeft])
}

// Ready-made tuition plans a coach defines once and picks when recording a payment
model Plan {
  id           String   @id @default(cuid())
  gymId        String
  name         String
  amount       Int // toman
  durationDays Int // 30 | 60 | 90
  createdAt    DateTime @default(now())
  gym          Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
}

// An assistant coach. A coach user belongs to at most one gym (as owner or assistant).
model GymCoach {
  id        String   @id @default(cuid())
  gymId     String
  userId    String   @unique
  createdAt DateTime @default(now())
  gym       Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([gymId])
}
