# Neon (Vercel Storage > Neon) sets these automatically on Vercel.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/neondb?sslmode=require"
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Web Push (notifications). Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"
# Protects /api/cron/reminders. Vercel Cron sends it automatically. Generate with: openssl rand -base64 32
CRON_SECRET=""
